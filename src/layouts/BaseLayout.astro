---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  navVariant?: 'home' | 'legal';
  footerDescription?: boolean;
}

const {
  title,
  description,
  noindex = false,
  navVariant = 'legal',
  footerDescription = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname.replace(/index\.html$/, ''), Astro.site).href;
---

<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  {noindex && <meta name="robots" content="noindex, follow" />}
  {!noindex && <link rel="canonical" href={canonical} />}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta name="theme-color" content="#ECE4D8" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="de_DE" />
  <meta property="og:site_name" content="Kaza Living" />
  <meta property="og:title" content={title} />
  {description && <meta property="og:description" content={description} />}
  <meta property="og:url" content={canonical} />
  <link rel="stylesheet" href="/css/fonts.css" />
  <slot name="head" />
</head>
<body>
  <Header variant={navVariant} />
  <slot />
  <Footer showDescription={footerDescription} />
</body>
</html>
