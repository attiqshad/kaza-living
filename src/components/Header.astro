---
export interface Props {
  variant?: 'home' | 'legal';
}
const { variant = 'legal' } = Astro.props;
---
<header>
  <div class="wrap nav">
    <a href={variant === 'home' ? '#top' : '/'} class="wordmark" aria-label="Kaza Living Startseite"><span class="ipa">'</span>ka<span class="ipa">:</span>za</a>

    {variant === 'home' ? (
      <nav class="nav-links" id="menu">
        <a href="#shop">Shop</a>
        <a href="#beratung">Beratung</a>
        <a href="#kontakt">Kontakt</a>
        <a href="#kontakt" class="nav-cta">Anfrage</a>
      </nav>
    ) : (
      <nav class="nav-links">
        <a href="/">Zur Startseite</a>
      </nav>
    )}

    {variant === 'home' && (
      <button class="burger" id="burger" aria-label="Menü öffnen" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
    )}
  </div>
</header>
