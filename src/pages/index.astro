---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="'ka:za — Kaza Living | Wohnaccessoires & Dekorationsberatung"
  description="Kaza Living: ausgesuchte Wohn- und Küchenaccessoires sowie persönliche Dekorationsberatung für Haus, Heim und Locations – inklusive Umsetzung mit Handwerkern."
  navVariant="home"
  footerDescription={true}
>

<a id="top"></a>

<!-- ============ HERO ============ -->
<section class="hero wrap">
  <div class="hero-grid">
    <div class="reveal">
      <span class="eyebrow">Wohnaccessoires &amp; Dekoration</span>
      <h1>Zuhause,<br>schön <em>gemacht.</em></h1>
      <p class="lead">Ausgesuchte Wohn- und Küchenaccessoires aus natürlichen Materialien — und persönliche Beratung, die aus Räumen ein Zuhause macht.</p>
      <div class="pron">
        <span><b>'ka:za</b> — von <i>casa</i>, das Haus.</span>
      </div>
      <div class="hero-actions">
        <a href="#shop" class="btn btn-dark">
          Zum Shop
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <a href="#beratung" class="btn btn-line">Dekorationsberatung</a>
      </div>
    </div>
    <div class="reveal">
      <div class="frame hero-img g-oat">
        <img src="/img/hero.svg" alt="Hell und natürlich eingerichteter Wohnraum mit Korbaccessoires" loading="eager">
        <span class="hero-tag">Natürliche Materialien · Rattan, Seegras, Bast</span>
      </div>
    </div>
  </div>
</section>

<!-- ============ DER ZWEITEILER ============ -->
<section class="wrap" id="leistungen">
  <div class="split-head reveal">
    <span class="eyebrow">Zwei Welten, ein Anspruch</span>
    <h2>Produkte zum Mitnehmen — Gestaltung zum Erleben</h2>
    <p>Ob Sie ein einzelnes Lieblingsstück suchen oder einen ganzen Raum neu denken: Kaza Living begleitet beides — vom fertigen Produkt bis zur kompletten Umsetzung vor Ort.</p>
  </div>

  <div class="split">
    <!-- Panel 1: Shop -->
    <article class="panel reveal" id="shop-teaser">
      <div class="bg frame g-honey">
        <img src="/img/panel-shop.svg" alt="Geflochtene Aufbewahrungskörbe und Wohnaccessoires" loading="lazy">
      </div>
      <span class="kicker">01 — Der Shop</span>
      <h3>Wohnen &amp; Küche</h3>
      <p>Kuratierte Aufbewahrung, Körbe und Küchenhelfer aus natürlichen Materialien. Direkt erhältlich in unseren Marktplatz-Shops.</p>
      <div class="panel-actions">
        <a href="https://www.ebay.de/" target="_blank" rel="noopener" class="chip">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9h18M3 9l2-5h14l2 5M3 9v10a1 1 0 001 1h16a1 1 0 001-1V9M9 13h6"/></svg>
          eBay Shop
        </a>
        <a href="https://www.amazon.de/" target="_blank" rel="noopener" class="chip ghost">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9h18M3 9l2-5h14l2 5M3 9v10a1 1 0 001 1h16a1 1 0 001-1V9"/></svg>
          Amazon Store
        </a>
      </div>
    </article>

    <!-- Panel 2: Beratung -->
    <article class="panel reveal" id="beratung-teaser">
      <div class="bg frame g-espresso">
        <img src="/img/panel-atelier.svg" alt="Stilvoll gestalteter Innenraum mit warmen Naturtönen" loading="lazy">
      </div>
      <span class="kicker">02 — Das Atelier</span>
      <h3>Dekorationsberatung</h3>
      <p>Wir gestalten Haus, Heim und Locations — von der Idee bis zur fertigen Umsetzung. Auf Wunsch inklusive Koordination externer Handwerker.</p>
      <div class="panel-actions">
        <a href="#beratung" class="chip">Mehr erfahren
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <a href="#kontakt" class="chip ghost">Termin anfragen</a>
      </div>
    </article>
  </div>
</section>

<!-- ============ PRODUKTE ============ -->
<section class="section wrap" id="shop">
  <div class="sec-head reveal">
    <div>
      <span class="eyebrow">Ausgewählte Produkte</span>
      <h2>Schöne Dinge für jeden Raum</h2>
    </div>
    <p>Eine kleine Auswahl unserer Lieblingsstücke. Das vollständige Sortiment finden Sie in unseren Shops.</p>
  </div>

  <div class="products">
    <article class="card reveal">
      <div class="frame g-honey">
        <img src="/img/product-baskets.svg" alt="Geflochtener Aufbewahrungskorb aus Rattan" loading="lazy">
      </div>
      <div class="card-body">
        <span class="tag">Aufbewahrung</span>
        <h3>Geflochtene Körbe</h3>
        <p>Rattan, Seegras &amp; Bast — Ordnung mit natürlicher Wärme.</p>
      </div>
    </article>

    <article class="card reveal">
      <div class="frame g-oat">
        <img src="/img/product-kitchen.svg" alt="Ordentlich organisierte Küchenschublade mit Helfern" loading="lazy">
      </div>
      <div class="card-body">
        <span class="tag">Küche</span>
        <h3>Küchen-Organizer</h3>
        <p>Durchdachte Helfer für Schublade, Arbeitsfläche und Vorrat.</p>
      </div>
    </article>

    <article class="card reveal">
      <div class="frame g-clay">
        <img src="/img/product-decor.svg" alt="Dekorative Wohnaccessoires auf einem Sideboard" loading="lazy">
      </div>
      <div class="card-body">
        <span class="tag">Dekoration</span>
        <h3>Wohnaccessoires</h3>
        <p>Vasen, Schalen und Akzente, die Räume zum Leben bringen.</p>
      </div>
    </article>
  </div>

  <div class="shop-links reveal">
    <span>Jetzt entdecken:</span>
    <a href="https://www.ebay.de/" target="_blank" rel="noopener" class="btn btn-dark">
      eBay Shop besuchen
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H8M17 7v9"/></svg>
    </a>
    <a href="https://www.amazon.de/" target="_blank" rel="noopener" class="btn btn-line">
      Amazon Store besuchen
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H8M17 7v9"/></svg>
    </a>
  </div>
</section>

<!-- ============ BERATUNG ============ -->
<section class="section beratung" id="beratung">
  <div class="wrap">
    <div class="sec-head reveal">
      <div>
        <span class="eyebrow">Dekorationsberatung</span>
        <h2>Wir gestalten Haus, Heim &amp; Location</h2>
      </div>
      <p>Persönliche Beratung mit Konzept — und auf Wunsch der kompletten Umsetzung durch erfahrene Handwerkerinnen und Handwerker aus unserem Netzwerk.</p>
    </div>

    <div class="steps">
      <div class="step reveal">
        <span class="num">01 / Beratung</span>
        <h3>Erstgespräch &amp; Vision</h3>
        <p>Wir hören zu, schauen uns Ihren Raum an und entwickeln gemeinsam eine Richtung — für Privatwohnung, Eigenheim oder Event-Location.</p>
      </div>
      <div class="step reveal">
        <span class="num">02 / Konzept</span>
        <h3>Gestaltungskonzept</h3>
        <p>Material, Farbe, Möblierung und Dekoration in einem stimmigen Konzept — mit konkreter Produkt- und Budgetempfehlung.</p>
      </div>
      <div class="step reveal">
        <span class="num">03 / Umsetzung</span>
        <h3>Realisierung mit Handwerkern</h3>
        <p>Auf Wunsch koordinieren wir die komplette Umsetzung vor Ort und arbeiten dafür mit ausgewählten externen Handwerkern zusammen.</p>
      </div>
    </div>

    <div class="frame beratung-img g-sage reveal">
      <img src="/img/beratung.svg" alt="Fertig gestalteter, wohnlicher Innenraum in warmen Naturtönen" loading="lazy">
    </div>
  </div>
</section>

<!-- ============ KONTAKT ============ -->
<section class="section wrap contact" id="kontakt">
  <div class="contact-grid">
    <div class="reveal">
      <span class="eyebrow">Kontakt</span>
      <h2>Sprechen wir über Ihren Raum.</h2>
      <p class="lead">Frage zu einem Produkt oder Interesse an einer Beratung? Schreiben Sie uns — wir melden uns zeitnah zurück.</p>

      <div class="contact-list">
        <div class="crow">
          <span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg></span>
          <span><span class="lbl">E-Mail</span><br><a class="val" href="mailto:info@kaza-living.de">info@kaza-living.de</a></span>
        </div>
        <div class="crow">
          <span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M5 4h4l2 5-3 2a11 11 0 005 5l2-3 5 2v4a2 2 0 01-2 2A16 16 0 013 6a2 2 0 012-2z"/></svg></span>
          <span><span class="lbl">Telefon</span><br><a class="val" href="tel:+4915205168185">+49 152 05168185</a></span>
        </div>
        <div class="crow">
          <span class="ic wa"><svg viewBox="0 0 24 24" fill="none" stroke-width="2"><path d="M20 12a8 8 0 01-11.8 7L4 20l1.1-4A8 8 0 1120 12z"/><path d="M9 9c0 3 3 6 6 6l1.5-1.5-2-1-1 .8c-1-.4-2-1.4-2.4-2.4l.8-1-1-2L9 9z"/></svg></span>
          <span><span class="lbl">WhatsApp</span><br><a class="val" href="https://wa.me/4915205168185?text=Hallo%20Kaza%20Living%2C%20ich%20habe%20eine%20Frage." target="_blank" rel="noopener">+49 152 05168185</a></span>
        </div>
        <div class="crow">
          <span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke-width="2"><circle cx="12" cy="11" r="3"/><path d="M12 2a7 7 0 017 7c0 5-7 13-7 13S5 14 5 9a7 7 0 017-7z"/></svg></span>
          <span><span class="lbl">Web</span><br><a class="val" href="https://kaza-living.de" target="_blank" rel="noopener">kaza-living.de</a></span>
        </div>
      </div>
    </div>

    <div class="contact-card reveal">
      <span class="wordmark"><span class="ipa">'</span>ka<span class="ipa">:</span>za</span>
      <p>Kaza Living — Wohnaccessoires &amp; Dekorationsberatung. Für ein Zuhause, das sich wie eines anfühlt.</p>
      <div style="display:flex;flex-wrap:wrap;gap:12px">
        <a href="mailto:info@kaza-living.de?subject=Anfrage%20Dekorationsberatung" class="btn">
          Anfrage senden
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <a href="https://wa.me/4915205168185?text=Hallo%20Kaza%20Living%2C%20ich%20habe%20eine%20Frage." target="_blank" rel="noopener" class="btn wa-btn">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.5 14.4c-.3-.15-1.7-.85-2-.95-.25-.1-.45-.15-.65.15-.2.3-.75.95-.9 1.15-.15.2-.35.2-.65.05-1.75-.85-2.9-1.55-4.05-3.55-.3-.5.3-.5.85-1.6.1-.2.05-.35 0-.5-.05-.15-.65-1.6-.9-2.15-.25-.55-.5-.5-.65-.5h-.55c-.2 0-.5.05-.75.35-.25.3-1 1-1 2.4 0 1.45 1.05 2.85 1.2 3.05.15.2 2.05 3.15 5 4.4 1.85.8 2.6.85 3.5.7.55-.05 1.7-.7 1.95-1.35.25-.65.25-1.2.15-1.35-.1-.1-.3-.15-.6-.3z"/><path d="M12 2a10 10 0 00-8.6 15l-1.3 4.8 4.9-1.3A10 10 0 1012 2zm0 18.2a8.1 8.1 0 01-4.15-1.15l-.3-.18-3 .8.8-2.9-.2-.3A8.2 8.2 0 1112 20.2z"/></svg>
          WhatsApp
        </a>
      </div>
    </div>
  </div>
</section>

<!-- ============ IMPRESSUM ============ -->
<section class="section wrap" id="impressum">
  <div class="sec-head reveal">
    <div>
      <span class="eyebrow">Rechtliches</span>
      <h2>Impressum</h2>
    </div>
  </div>
  <div class="reveal" style="max-width:52ch">
    <p><strong>Angaben gemäß § 5 TMG</strong></p>
    <p style="margin-top:14px">
      Attiq Shad<br>
      Kaza Living<br>
      Am Schelmengraben 11<br>
      64720 Michelstadt<br>
      Deutschland
    </p>
    <p style="margin-top:14px">
      <strong>Kontakt</strong><br>
      Telefon: <a href="tel:+4915205168185">+49 152 05168185</a><br>
      E-Mail: <a href="mailto:info@kaza-living.de">info@kaza-living.de</a>
    </p>
    <p style="margin-top:14px;color:var(--ink-mute);font-size:14.5px">
      Verantwortlich für den Inhalt nach § 55 Abs. 2 RStV: Attiq Shad, Anschrift wie oben.
    </p>
  </div>
</section>

<!-- Floating WhatsApp -->
<a class="wa-float" href="https://wa.me/4915205168185?text=Hallo%20Kaza%20Living%2C%20ich%20habe%20eine%20Frage." target="_blank" rel="noopener" aria-label="Über WhatsApp kontaktieren">
  <svg viewBox="0 0 24 24"><path d="M17.5 14.4c-.3-.15-1.7-.85-2-.95-.25-.1-.45-.15-.65.15-.2.3-.75.95-.9 1.15-.15.2-.35.2-.65.05-1.75-.85-2.9-1.55-4.05-3.55-.3-.5.3-.5.85-1.6.1-.2.05-.35 0-.5-.05-.15-.65-1.6-.9-2.15-.25-.55-.5-.5-.65-.5h-.55c-.2 0-.5.05-.75.35-.25.3-1 1-1 2.4 0 1.45 1.05 2.85 1.2 3.05.15.2 2.05 3.15 5 4.4 1.85.8 2.6.85 3.5.7.55-.05 1.7-.7 1.95-1.35.25-.65.25-1.2.15-1.35-.1-.1-.3-.15-.6-.3z"/><path d="M12 2a10 10 0 00-8.6 15l-1.3 4.8 4.9-1.3A10 10 0 1012 2zm0 18.2a8.1 8.1 0 01-4.15-1.15l-.3-.18-3 .8.8-2.9-.2-.3A8.2 8.2 0 1112 20.2z"/></svg>
</a>

</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .hero{position:relative;padding:84px 0 64px}
  .hero-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:56px;align-items:center}
  .hero h1{font-size:clamp(44px,7vw,84px);font-weight:300}
  .hero h1 em{font-style:italic;color:var(--honey-deep)}
  .hero .lead{margin-top:24px;font-size:19px;color:var(--ink-mute);max-width:30ch}
  .pron{
    margin-top:30px;display:inline-flex;align-items:center;gap:14px;
    font-family:"Poppins";font-weight:300;font-size:15px;color:var(--ink-mute);
    border-top:1px solid var(--line);padding-top:20px;
  }
  .pron b{font-weight:400;color:var(--ink)}
  .hero-actions{display:flex;flex-wrap:wrap;gap:14px;margin-top:34px}
  .hero-img{aspect-ratio:4/5;box-shadow:0 40px 70px -40px rgba(42,36,32,.55)}
  .hero-tag{
    position:absolute;left:18px;bottom:18px;z-index:2;
    background:rgba(246,241,232,.92);backdrop-filter:blur(4px);
    border-radius:40px;padding:8px 16px;font-size:12.5px;letter-spacing:.04em;color:var(--ink)
  }

  /* ---------- Split — der Zweiteiler ---------- */
  .split-head{text-align:center;padding:30px 0 10px}
  .split-head .eyebrow{justify-content:center}
  .split-head .eyebrow::before{display:none}
  .split-head h2{font-size:clamp(30px,4.4vw,46px);font-weight:300}
  .split-head p{color:var(--ink-mute);max-width:54ch;margin:14px auto 0}

  .split{display:grid;grid-template-columns:1fr 1fr;gap:22px;margin-top:40px}
  .panel{
    position:relative;border-radius:20px;overflow:hidden;min-height:560px;
    display:flex;flex-direction:column;justify-content:flex-end;
    padding:38px;color:var(--paper-soft);isolation:isolate;
    transition:transform .35s ease;
  }
  .panel:hover{transform:translateY(-4px)}
  .panel .bg{position:absolute;inset:0;z-index:-2}
  .panel::before{
    content:"";position:absolute;inset:0;z-index:-1;
    background:linear-gradient(180deg,rgba(20,16,13,.05) 0%,rgba(20,16,13,.35) 45%,rgba(20,16,13,.86) 100%);
  }
  .panel .kicker{font-size:12.5px;letter-spacing:.2em;text-transform:uppercase;color:rgba(246,241,232,.8);margin-bottom:14px}
  .panel h3{font-size:34px;font-weight:300;color:#fff}
  .panel p{margin-top:14px;color:rgba(246,241,232,.9);max-width:38ch;font-size:16px}
  .panel .panel-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:26px}
  .chip{
    display:inline-flex;align-items:center;gap:9px;font-size:14px;
    background:rgba(246,241,232,.95);color:var(--ink);border-radius:40px;padding:11px 20px;
    transition:transform .2s,background .2s;
  }
  .chip:hover{transform:translateY(-2px);background:#fff}
  .chip.ghost{background:transparent;border:1px solid rgba(246,241,232,.55);color:var(--paper-soft)}
  .chip.ghost:hover{background:rgba(246,241,232,.14)}
  .chip svg{width:15px;height:15px}

  /* ---------- Produkte ---------- */
  .products{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
  .card{background:var(--paper-soft);border-radius:18px;overflow:hidden;border:1px solid var(--line);transition:transform .3s,box-shadow .3s}
  .card:hover{transform:translateY(-5px);box-shadow:0 26px 44px -28px rgba(42,36,32,.5)}
  .card .frame{border-radius:0;aspect-ratio:1/1}
  .card .frame::after{box-shadow:none}
  .card-body{padding:22px 22px 24px}
  .card-body h3{font-size:21px;font-weight:500}
  .card-body p{font-size:14.5px;color:var(--ink-mute);margin-top:6px}
  .card .tag{font-size:11.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--honey-deep)}

  .shop-links{display:flex;gap:14px;flex-wrap:wrap;align-items:center;justify-content:center;margin-top:46px}
  .shop-links span{color:var(--ink-mute);font-size:14px}

  /* ---------- Beratung process ---------- */
  .beratung{background:var(--espresso);color:var(--paper-soft)}
  .beratung .eyebrow{color:#D9A86A}
  .beratung .eyebrow::before{background:#D9A86A}
  .beratung h2{color:#fff}
  .beratung .sec-head p{color:rgba(246,241,232,.72)}
  .steps{display:grid;grid-template-columns:repeat(3,1fr);gap:0;border-top:1px solid var(--line-light)}
  .step{padding:36px 30px 36px 0;border-right:1px solid var(--line-light)}
  .step:last-child{border-right:0;padding-right:0}
  .step .num{font-family:"Fraunces";font-size:15px;color:#D9A86A;letter-spacing:.1em}
  .step h3{font-size:24px;font-weight:400;color:#fff;margin:16px 0 12px}
  .step p{color:rgba(246,241,232,.78);font-size:15.5px}
  .beratung-img{aspect-ratio:21/9;margin-top:46px;box-shadow:0 40px 70px -44px rgba(0,0,0,.7)}

  /* ---------- Kontakt ---------- */
  .contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center}
  .contact h2{font-size:clamp(30px,4.4vw,48px);font-weight:300}
  .contact .lead{color:var(--ink-mute);margin-top:16px;max-width:36ch}
  .contact-list{margin-top:30px;display:flex;flex-direction:column;gap:2px}
  .crow{display:flex;align-items:center;gap:16px;padding:16px 0;border-top:1px solid var(--line)}
  .crow:last-child{border-bottom:1px solid var(--line)}
  .crow .ic{width:40px;height:40px;border-radius:50%;background:var(--paper-soft);border:1px solid var(--line);display:grid;place-items:center;flex:none}
  .crow .ic svg{width:18px;height:18px;stroke:var(--honey-deep)}
  .crow .lbl{font-size:12.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-mute)}
  .crow .val{font-size:17px;color:var(--ink)}
  .crow .ic.wa svg{stroke:#1F9C4D}
  .contact-card{background:var(--espresso);color:var(--paper-soft);border-radius:22px;padding:44px}
  .contact-card .wordmark{font-size:40px;color:#fff}
  .contact-card .wordmark .ipa{color:#D9A86A;opacity:1}
  .contact-card p{color:rgba(246,241,232,.8);margin-top:18px}
  .contact-card .btn{margin-top:28px;background:#D9A86A;color:var(--espresso)}
  .contact-card .btn:hover{box-shadow:0 14px 30px -16px rgba(0,0,0,.6)}

  /* ---------- WhatsApp ---------- */
  .wa-btn{background:#25D366 !important;color:#fff !important}
  .wa-btn:hover{box-shadow:0 14px 30px -16px rgba(37,211,102,.9)}
  .wa-float{
    position:fixed;right:22px;bottom:22px;z-index:60;
    width:58px;height:58px;border-radius:50%;
    background:#25D366;display:grid;place-items:center;
    box-shadow:0 12px 28px -8px rgba(37,211,102,.7);
    transition:transform .2s;
  }
  .wa-float:hover{transform:translateY(-3px) scale(1.04)}
  .wa-float svg{width:30px;height:30px;fill:#fff}
  .wa-float::after{
    content:"WhatsApp";position:absolute;right:70px;white-space:nowrap;
    background:var(--espresso);color:var(--paper-soft);font-size:13px;
    padding:7px 13px;border-radius:8px;opacity:0;pointer-events:none;transition:opacity .2s;
  }
  .wa-float:hover::after{opacity:1}
  @media (max-width:600px){.wa-float{width:52px;height:52px;right:16px;bottom:16px}.wa-float::after{display:none}}

  @media (prefers-reduced-motion:reduce){.panel:hover,.card:hover,.btn:hover,.chip:hover{transform:none}}

  /* ---------- Responsive ---------- */
  @media (max-width:920px){
    .hero-grid{grid-template-columns:1fr;gap:40px}
    .hero-img{aspect-ratio:16/11;max-height:440px}
    .split{grid-template-columns:1fr}
    .products{grid-template-columns:1fr 1fr}
    .steps{grid-template-columns:1fr}
    .step{border-right:0;border-bottom:1px solid var(--line-light);padding:28px 0}
    .step:last-child{border-bottom:0}
    .contact-grid{grid-template-columns:1fr;gap:34px}
  }
  @media (max-width:600px){
    .products{grid-template-columns:1fr}
    .panel{min-height:440px;padding:28px}
    .contact-card{padding:30px}
  }
</style>

<script>
  // Mobile menu
  const burger = document.getElementById('burger');
  const menu = document.getElementById('menu');
  if (burger && menu) {
    burger.addEventListener('click', () => {
      const open = menu.classList.toggle('open');
      burger.setAttribute('aria-expanded', String(open));
    });
    menu.querySelectorAll('a').forEach((a) => {
      a.addEventListener('click', () => {
        menu.classList.remove('open');
        burger.setAttribute('aria-expanded', 'false');
      });
    });
  }

  // Scroll reveal
  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add('in');
          io.unobserve(e.target);
        }
      });
    },
    { threshold: 0.12 }
  );
  document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
</script>
